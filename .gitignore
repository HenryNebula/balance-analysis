# Statements are real financial data — never commit PDFs.
# The ONLY exception: synthetic fixtures, generated by tools/fixtures/gen_fixtures.py
*.pdf
!tests/fixtures/*.pdf

# Machine-specific uv paths (disks differ per machine)
.envrc

# Local endpoint configuration (may contain the LAN server address/api key)
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
cov-*.xml
coverage.xml

# Scratch outputs
last_draft.json
ab_report.json

# Per-run harness traces (contain statement text)
logs/

# Downloaded test datasets + web UI account storage (statements, parsed ledgers)
# Real statements and some test corpora carry real PII — keep it all local.
data/

# uv project cache dirs created on some machines
.uv/

# Build artifacts
dist/
