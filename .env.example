# Copy to .env and adjust. Loaded automatically by config_harness.py and
# compare_engines.py; exported environment variables always win.

# The machine running llama-server (bind it to 0.0.0.0 to serve the LAN).
TRANSTRACTOR_LLM_URL=http://127.0.0.1:30000/v1
TRANSTRACTOR_LLM_MODEL=qwen3.5-4b
# Qwen3-style thinking models must disable thinking for extraction.
TRANSTRACTOR_LLM_NO_THINK=1
# Correction turns for the config drafting loop (CLI --rounds overrides).
TRANSTRACTOR_LLM_ROUNDS=5
# Request timeout in seconds.
TRANSTRACTOR_LLM_TIMEOUT=600
# Optional: llama-server --api-key
# TRANSTRACTOR_LLM_API_KEY=
# Optional: where verified configs are stored (default ./configs)
# TRANSTRACTOR_LLM_CONFIG_DIR=configs
