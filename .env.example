# tools/distill_agent.py configuration — copy to .env and fill in.
# Environment variables always override this file. NEVER commit the real .env.

# OpenAI-compatible chat endpoint. Either the API root (…/v1, /chat/completions
# is appended) or the full endpoint path, both accepted.
STATEMENTLEDGER_LLM_URL=https://openrouter.ai/api/v1

# Model id as the endpoint knows it.
STATEMENTLEDGER_LLM_MODEL=openai/gpt-6-luna

# Bearer token (leave unset for a purely local llama-server endpoint).
STATEMENTLEDGER_LLM_API_KEY=

# OpenRouter-only routing pin (no-op elsewhere, absent unless set):
# comma-separated endpoints, e.g. "azure" or "amazon-bedrock/us-east-1".
# Pinned endpoints get provider.allow_fallbacks=false — needed when the
# account guardrail (e.g. ZDR) excludes other providers of the same model.
STATEMENTLEDGER_LLM_PROVIDER=azure

# OpenRouter-only: "true" sends reasoning: {enabled: true}.
STATEMENTLEDGER_LLM_REASONING=true

# Agent turns for the distill harness (CLI --turns overrides).
STATEMENTLEDGER_LLM_TURNS=80

# Loop policy is advisory-only. After this many consecutive crashed runs
# (CLI --crash-streak overrides) the tool result carries a look-first note.
STATEMENTLEDGER_CRASH_STREAK=3

# After this many look-only turns in a row (CLI --max-look-streak overrides)
# the model is nudged to write parser.py.
STATEMENTLEDGER_MAX_LOOK_STREAK=6

# Elide old model turns past this many conversation chars (CLI
# --compact-chars overrides). Align with the model's context window:
# threshold = (0.9 * ctx - tool-schema tokens) * chars-per-token, measured
# on real payloads (llama-server /tokenize) — dense JSON output runs ~2.9
# chars/token, so a 64k-ctx local model lands near 168000. The loop also
# force-elides and retries when the endpoint rejects a request for size,
# so a stale ratio degrades instead of killing the run.
STATEMENTLEDGER_COMPACT_CHARS=120000

# Request timeout in seconds.
STATEMENTLEDGER_LLM_TIMEOUT=300
