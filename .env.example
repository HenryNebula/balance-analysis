# distill_harness.py / config_harness.py configuration — copy to .env and fill in.
# Environment variables always override this file. NEVER commit the real .env.

# OpenAI-compatible chat endpoint. Either the API root (…/v1, /chat/completions
# is appended) or the full endpoint path, both accepted.
TRANSTRACTOR_LLM_URL=https://openrouter.ai/api/v1

# Model id as the endpoint knows it.
TRANSTRACTOR_LLM_MODEL=openai/gpt-6-luna

# Bearer token (leave unset for a purely local llama-server endpoint).
TRANSTRACTOR_LLM_API_KEY=

# OpenRouter-only routing pin (no-op elsewhere, absent unless set):
# comma-separated endpoints, e.g. "azure" or "amazon-bedrock/us-east-1".
# Pinned endpoints get allow_fallbacks=false — needed when the account
# guardrail (e.g. ZDR) excludes other providers of the same model.
TRANSTRACTOR_LLM_PROVIDER=azure

# OpenRouter-only: "true" sends reasoning: {enabled: true}.
TRANSTRACTOR_LLM_REASONING=true

# llama-server-only Qwen thinking switch (ignored by remote endpoints).
TRANSTRACTOR_LLM_NO_THINK=1

# REPL turns for distill_harness.py (CLI --rounds overrides).
TRANSTRACTOR_LLM_ROUNDS=30

# Burner probes are uncapped; from 90% of turns used the harness warns
# on every probe that only a full script can converge the run.

# Request timeout in seconds.
TRANSTRACTOR_LLM_TIMEOUT=300
